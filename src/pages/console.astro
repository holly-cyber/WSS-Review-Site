  $('emDraftNew').addEventListener('click',emNewDraft);
  $('emDraftDelete').addEventListener('click',emDeleteDraft);
  emLoadDrafts();
  emInitDrag();
  // Groups + push
  emLoadGroups();
  $('emPushBtn').addEventListener('click',emPushDraft);
