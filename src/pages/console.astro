<script>
import { ghApi, scrapeImages, b64, b64decode, esc, splitFrontmatter, fmField, setDraftFlag, setReviewer, setFrontmatterField, linkFirstProductMention, parsePillarScores, setPillarScore, setOverallScore, recalcOverall, syncBodyScores, isDraft, reviewPreviewHtml, mdToHtml, aiStream, NEWS_SYSTEM, buildNewsPrompt, buildRewritePrompt, sourceOverlap, isWomensContent, isWomensFeed, BLOG_SYSTEM, buildBlogPrompt, insertImages, reviewMeta, isReviewPath, apiUrl, buildEmailHtml, EMAIL_THEMES, EMAIL_ASSIST_SYSTEM } from '../lib/review-admin.js';
import { team } from '../data/team.js';
import { feeds } from '../data/feeds.js';
import { slugify } from '../data/taxonomy.js';

const $ = (id) => document.getElementById(id);
function alert(id, type, msg){ const el=$(id); if(el) el.innerHTML = msg?`<div class="al ${type}">${msg}</div>`:''; }

let files = [];        // {path, sha, category, slug, title, brand, tested_by, overall, draft, content, liveUrl}
let current = null;    // file being edited
let imgs = [], sel = []; // image stage state

// ---- Navigation ----
let nwLibLoaded=false;
function showView(name){
  document.querySelectorAll('.navbtn').forEach(b=>b.classList.toggle('active', b.dataset.nav===name));
  document.querySelectorAll('.view').forEach(v=>v.classList.remove('active'));
  $('view-'+name).classList.add('active');
  if(name==='news' && !nwLibLoaded){ nwLibLoaded=true; loadNwLib(); }
  if(name==='blog'){ if(!blLibLoaded){ blLibLoaded=true; loadBlLib(); } updateBlCatalogNote(); }
  if(name==='email'){ emInitStudio(); emRefreshItems(); }
  if(name==='socialstudio'){ scInitStudio(); scRefreshItems(); }
  // Load the embedded pipeline tool the first time its tab is opened.
  if(name==='pipeline'){ const f=$('pipelineFrame'); if(f && !f.src) f.src='/pipeline?embed=1'; }
  // Remember the current tab so a refresh returns here (only real nav tabs, not
  // the transient editor view).
  if(document.querySelector('.navbtn[data-nav="'+name+'"]')){ try{ localStorage.setItem('wssConsoleView', name); }catch(_){ } }
}
document.querySelectorAll('.navbtn').forEach(b=>b.addEventListener('click',()=>showView(b.dataset.nav)));
// Restore the last tab on load (falls back to the default Dashboard).
try{ const _v=localStorage.getItem('wssConsoleView'); if(_v && _v!=='dashboard' && $('view-'+_v) && document.querySelector('.navbtn[data-nav="'+_v+'"]')) showView(_v); }catch(_){ }

// ---- Load all reviews ----
// Concurrency-limited pool: fetching every file at once trips GitHub's
// secondary rate limit, which made the dashboard hang on "Loading…".
const POOL = 6;
async function runPool(items, worker){
  let idx = 0;
  const next = async()=>{ while(idx<items.length){ const i=idx++; await worker(items[i], i); } };
  await Promise.all(Array.from({length:Math.min(POOL, items.length)}, next));
}

// Fetch + parse a single review's content on demand (used by the hydrate
// pass and lazily by the editor/preview). No-op if already loaded.
async function ensureContent(f){
  if(f.content) return f;
  const d = await ghApi('get', {path:f.path});
  f.sha = d.sha; f.content = b64decode(d.content);
  const { fm } = splitFrontmatter(f.content);
  f.title = fmField(fm,'title')||f.slug; f.brand = fmField(fm,'brand');
  f.tested_by = fmField(fm,'tested_by'); f.overall = fmField(fm,'overall_score');
  f.draft = isDraft(f.content);
  return f;
}

async function loadAll(){
  alert('revAlert','inf','Loading reviews…'); alert('dashAlert','inf','Loading…');
  try{
    const tree = await ghApi('tree', {});
    const paths = (tree.tree||[]).filter(t=>t.type==='blob' && isReviewPath(t.path)).map(t=>t.path);
    // Build the list from the tree alone so the UI is usable immediately.
    files = paths.map((path)=>{ const m=reviewMeta(path);
      return { path, sha:'', ...m, content:'', title:m.slug, brand:'', tested_by:'', overall:'', draft:undefined }; })
      .sort((a,b)=>a.path.localeCompare(b.path));
    alert('dashAlert','','');
    renderDashboard(); renderTable();
    if(!files.length){ alert('revAlert',''); return; }
    // Hydrate metadata (title, score, reviewer, draft state) in small batches.
    let done=0;
    alert('revAlert','inf',`Loading details for ${files.length} reviews…`);
    await runPool(files, async (f)=>{
      try{ await ensureContent(f); }catch(e){ f.error=e.message; }
      done++;
      if(done%8===0 || done===files.length){ renderDashboard(); renderTable();
        alert('revAlert','inf',`Loaded ${done}/${files.length}…`); }
    });
    renderDashboard(); renderTable();
    try{ emRefreshItems(); }catch(_){ }   // reviews just finished loading → refresh the Email studio picker
    try{ scRefreshItems(); }catch(_){ }   // …and the Social studio picker
    const failed=files.filter(f=>f.error).length;
    alert('revAlert', failed?'wr':'', failed?`Loaded with ${failed} error(s) — reload to retry.`:'');
  }catch(e){
    const msg = 'Could not load reviews: '+e.message+' <button id="reloadBtn" style="margin-left:10px;padding:4px 10px;border-radius:6px;border:0;background:#000036;color:#fff;cursor:pointer">Retry</button>';
    alert('revAlert','er',msg); alert('dashAlert','er',msg);
    document.querySelectorAll('#reloadBtn').forEach(b=>b.addEventListener('click',loadAll));
  }
}

// ---- Dashboard ----
function renderDashboard(){
  const total=files.length, live=files.filter(f=>f.draft===false).length, draft=files.filter(f=>f.draft===true).length;
  const nwTotal=nwLib.length, nwDraft=nwLib.filter(f=>f.draft).length;
  const blTotal=blLib.length, blDraft=blLib.filter(f=>f.draft).length;
  $('dashCards').innerHTML =
    `<div class="card"><div class="n">${total}</div><div class="l">Total reviews</div></div>`+
    `<div class="card"><div class="n">${live}</div><div class="l">Live</div></div>`+
    `<div class="card"><div class="n">${draft}</div><div class="l">Drafts</div></div>`+
    `<div class="card"><div class="n">${new Set(files.map(f=>f.category)).size}</div><div class="l">Categories</div></div>`+
    `<div class="card"><div class="n">${nwTotal}</div><div class="l">News articles${nwDraft?` · ${nwDraft} draft`:''}</div></div>`+
    `<div class="card"><div class="n">${blTotal}</div><div class="l">Blog posts${blDraft?` · ${blDraft} draft`:''}</div></div>`;
  const byCat={}; files.forEach(f=>{byCat[f.category]=(byCat[f.category]||0)+1;});
  const max=Math.max(1,...Object.values(byCat));
  $('dashCats').innerHTML = '<h3 style="font-size:13px;color:#000036;margin-bottom:10px">Reviews by category</h3>'+
    Object.entries(byCat).sort((a,b)=>b[1]-a[1]).map(([c,n])=>
      `<div class="catrow"><span class="nm">${esc(c)}</span><span class="bar"><span style="width:${(n/max*100)}%"></span></span><span class="ct">${n}</span></div>`).join('');
}

// ---- Reviews table ----
function filtered(){
  const q=($('fSearch').value||'').toLowerCase(), cat=$('fCat').value, st=$('fStatus').value;
  return files.filter(f=>{
    if(cat && f.category!==cat) return false;
    if(st==='draft' && f.draft!==true) return false;
    if(st==='live' && f.draft!==false) return false;
    if(q && !(f.title.toLowerCase().includes(q)||f.slug.toLowerCase().includes(q))) return false;
    return true;
  });
}
function badge(f){ if(f.draft===undefined) return '<span class="badge draft">?</span>'; return f.draft?'<span class="badge draft">Draft</span>':'<span class="badge live">Live</span>'; }
function renderTable(){
  const rows=filtered();
  $('revBody').innerHTML = rows.length ? rows.map((f,i)=>
    `<tr data-i="${files.indexOf(f)}">
      <td><div class="tt">${esc(f.title)}</div><div class="ts">${esc(f.slug)}</div></td>
      <td style="text-transform:capitalize">${esc(f.category)}</td>
      <td>${esc(f.tested_by||'—')}</td>
      <td>${f.overall?esc(f.overall)+' ★':'—'}</td>
      <td>${badge(f)}</td>
      <td><div class="rowacts">
        <button data-act="edit">Edit</button>
        <button data-act="preview">Preview</button>
        <button data-act="draft">${f.draft?'Publish':'Draft'}</button>
        <button data-act="delete" class="danger">Delete</button>
      </div></td>
    </tr>`).join('') : '<tr><td colspan="6" style="color:#999;padding:16px">No reviews match.</td></tr>';
}
['fSearch','fCat','fStatus'].forEach(id=>$(id).addEventListener('input',renderTable));
// Bulk re-host: for every review whose hero_image is a broken /wp-img/… (dead
// legacy WordPress upload), scrape the real product photo from its shop/product
// page and self-host it into public/images/reviews/, then repoint hero_image.
function setRehostAlert(t,m){ $('rehostAlert').innerHTML=m?`<div class="al ${t}">${m}</div>`:''; }
$('rehostImgs').addEventListener('click',rehostImages);
async function rehostImages(){
  if(!confirm('Re-host product photos for every review with a broken /wp-img/ hero image?\n\nFor each, this scrapes the shop/product page for the real photo, saves it into the repo, and updates the review. It runs one at a time and may take a few minutes.')) return;
  const btn=$('rehostImgs'); btn.disabled=true; btn.textContent='Re-hosting…';
  let done=0, fixed=0; const failed=[];
  // Find candidates fresh from the repo so we act on current content.
  const targets=[];
  for(const f of files){
    try{ const g=await ghApi('get',{path:f.path}); const content=b64decode(g.content); const {fm}=splitFrontmatter(content);
      const hero=fmField(fm,'hero_image');
      if(/^\/wp-img\//.test(hero) || /womenssportsstore\.com\/wp-content/.test(hero)) targets.push({f,sha:g.sha,content,fm});
    }catch(_){}
  }
  setRehostAlert('inf',`Found ${targets.length} review(s) with a broken hero image. Re-hosting…`);
  for(const t of targets){
    done++;
    const source=fmField(t.fm,'shopify_link')||fmField(t.fm,'product_url')||fmField(t.fm,'affiliate_link');
    if(!/^https?:\/\//i.test(source)){ failed.push(`${t.f.slug} — no product URL to scrape`); setRehostAlert('inf',`${done}/${targets.length} · ${fixed} fixed · ${failed.length} skipped`); continue; }
    try{
      const imgs=await scrapeImages(source);
      if(!imgs.length){ failed.push(`${t.f.slug} — no image found on ${source.replace(/^https?:\/\//,'').slice(0,30)}`); }
      else{
        const local=await hostHeroImage(imgs[0], t.f.slug, 'reviews');
        const updated=setFrontmatterField(t.content,'hero_image',local);
        const p=await ghApi('put',{path:t.f.path,content:b64(updated),message:`Re-host hero image: ${t.f.path}`,sha:t.sha});
        t.f.content=updated; t.f.sha=(p.content&&p.content.sha)||t.sha; fixed++;
      }
    }catch(e){ failed.push(`${t.f.slug} — ${e.message}`); }
    setRehostAlert('inf',`${done}/${targets.length} · ${fixed} fixed · ${failed.length} skipped`);
  }
  const msg=`Re-hosted ${fixed} of ${targets.length} hero image(s).`+(failed.length?` Couldn't do ${failed.length}: ${failed.slice(0,6).join('; ')}${failed.length>6?'…':''}`:'');
  setRehostAlert(failed.length?'wr':'ok',msg+' Netlify redeploys within ~60s.');
  btn.disabled=false; btn.textContent='🖼 Re-host images';
}
