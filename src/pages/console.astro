// Append a Netlify 301 redirect (public/_redirects) so a moved published review's
// old URL keeps working. Creates the file if needed; skips exact duplicates.
async function addRedirect(from,to){
  if(!from||!to||from===to) return;
  const path='public/_redirects';
  let content='', sha;
  try{ const g=await ghApi('get',{path}); sha=g.sha; content=b64decode(g.content); }catch(_){ content=''; }
  const line=`${from} ${to} 301`;
  if(content.split('\n').some(l=>l.trim()===line)) return;   // already present
  const updated=(content.replace(/\s*$/,'')+'\n'+line+'\n').replace(/^\n+/,'');
  await ghApi('put',{path,content:b64(updated),message:`Add redirect ${from} -> ${to}`,...(sha?{sha}:{})});
}
async function saveEditor(){
  if(!current) return;
  const btn=$('edSave'); btn.disabled=true; btn.textContent='Saving…'; alert('edAlert','inf','Saving…');
  try{
    const newCat=$('edCategory').value||current.category;
    let content=setFrontmatterField($('edBody').value,'category',newCat);   // keep frontmatter in step with the folder
    $('edBody').value=content;
    if(newCat!==current.category){
      // Move: create at the new path, then delete the old one.
      const oldUrl=current.liveUrl, wasPublished=current.draft===false;
      const newPath=`src/pages/${newCat}/${current.slug}.md`;
      let newSha; try{ const g=await ghApi('get',{path:newPath}); newSha=g.sha; }catch(_){}
      const put=await ghApi('put',{path:newPath, content:b64(content), message:`Move review to ${newCat}: ${newPath}`, ...(newSha?{sha:newSha}:{})});
      try{ const g=await ghApi('get',{path:current.path}); await ghApi('delete',{path:current.path, message:`Move review (remove old path): ${current.path}`, sha:g.sha}); }catch(_){}
      const oldPath=current.path;
      current.path=newPath; current.sha=(put.content&&put.content.sha)||''; current.category=newCat; current.liveUrl=`/${newCat}/${current.slug}/`;
      const fe=files.find(x=>x.path===oldPath); if(fe){ fe.path=newPath; fe.category=newCat; fe.liveUrl=current.liveUrl; }
      $('edPath').textContent=newPath; $('edView').href=current.liveUrl;
      // For a published review, drop a 301 from the old URL so it doesn't 404.
      let redir='';
      if(wasPublished){ try{ await addRedirect(oldUrl, current.liveUrl); redir=' A 301 redirect from the old URL was added.'; }catch(e){ redir=' (Couldn’t add the redirect: '+e.message+')'; } }
      alert('edAlert','ok',`Moved to “${esc(newCat)}” & saved ✓ New URL: ${esc(current.liveUrl)}.${esc(redir)}`);
    } else {
      const d=await ghApi('put',{path:current.path, content:b64(content), message:`Edit review: ${current.path}`, sha:current.sha});
      current.sha=d.content.sha;
      alert('edAlert','ok','Saved ✓ Netlify redeploys within ~60s.');
    }
    current.content=content;
    const {fm}=splitFrontmatter(content);
    current.title=fmField(fm,'title')||current.slug; current.tested_by=fmField(fm,'tested_by');
    current.overall=fmField(fm,'overall_score'); current.draft=isDraft(content);
    renderTable(); renderDashboard();
  }catch(e){ alert('edAlert','er','Save failed: '+e.message); }
  btn.disabled=false; btn.textContent='Save changes';
}
