// ---- Cross-links: let the user swap the reviews/news a blog post links to ----
function blLinkInternal(url){ return /^\/[a-z0-9-]+\/[a-z0-9-]+\/?(#.*)?$/i.test(url); }
function blLinkKind(url){ if(/^\/news\//.test(url)) return 'news'; if(/^\/blog\//.test(url)) return 'blog'; if(blLinkInternal(url)) return 'review'; return 'other'; }
function blParseLinks(body){
  const re=/\[([^\]\n]+)\]\((\/[^)\s]+)\)/g; const out=[]; let m;
  while((m=re.exec(body))){ if(blLinkInternal(m[2])) out.push({text:m[1], url:m[2], start:m.index, end:re.lastIndex}); }
  return out;
}
function blLinkOptions(currentUrl){
  const {reviews,news}=blogCatalog();
  const opt=(o)=>`<option value="${esc(o.url)}"${o.url===currentUrl?' selected':''}>${esc(o.title)}</option>`;
  const known=new Set([...reviews,...news].map(o=>o.url));
  let html='';
  if(currentUrl && !known.has(currentUrl)) html+=`<optgroup label="Current"><option value="${esc(currentUrl)}" selected>${esc(currentUrl)}</option></optgroup>`;
  if(reviews.length) html+=`<optgroup label="Reviews">${reviews.map(opt).join('')}</optgroup>`;
  if(news.length) html+=`<optgroup label="News">${news.map(opt).join('')}</optgroup>`;
  return html;
}
let blLinksBound=false;
function blRenderLinks(){
  const panel=$('blLinksPanel'), list=$('blLinksList'); if(!panel||!list) return;
  const links=blParseLinks($('blBody').value);
  $('blLinksCount').textContent=links.length||'';
  panel.style.display='block';
  if(!links.length){ list.innerHTML='<div class="hint" style="margin:0">No internal links yet. Add one by linking text in the body to a review or news page, then Rescan.</div>'; return; }
  list.innerHTML=links.map((lnk,i)=>{
    const kind=blLinkKind(lnk.url);
    return `<div class="bl-link-row" data-i="${i}"><input class="blk-text" data-i="${i}" value="${esc(lnk.text)}" title="Link wording"/><select class="blk-url" data-i="${i}">${blLinkOptions(lnk.url)}</select><span class="bl-link-kind ${kind}">${kind}</span></div>`;
  }).join('');
  if(!blLinksBound){
    // Apply on change (select pick, or text input blur) — not per keystroke, so
    // the row keeps focus while typing.
    list.addEventListener('change',e=>{ const el=e.target.closest('[data-i]'); if(el) blApplyLink(+el.dataset.i); });
    blLinksBound=true;
  }
}
function blApplyLink(i){
  const row=$('blLinksList').querySelector('.bl-link-row[data-i="'+i+'"]'); if(!row) return;
