  sel.innerHTML=(reviews.length?`<optgroup label="Reviews">${reviews.map(f=>opt(f,'review',f.path)).join('')}</optgroup>`:'')
             +(blog.length?`<optgroup label="Blog">${blog.map(f=>opt(f,'blog',f.slug)).join('')}</optgroup>`:'')
             +(news.length?`<optgroup label="News">${news.map(f=>opt(f,'news',f.slug)).join('')}</optgroup>`:'');
