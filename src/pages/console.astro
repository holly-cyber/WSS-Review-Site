async function emCustomImg(id,card,mode,ev){
  const st=emCustom[id]; if(!st) return;
  const status=card.querySelector('.em-cust-imgstatus');
  if(mode==='url'){
    const url=(card.querySelector('.em-cust-imgurl').value||'').trim();
