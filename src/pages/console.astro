$('blPush').addEventListener('click',pushBlog);
async function pushBlog(){
  const title=$('blTitle').value.trim(), slug=slugify($('blSlug').value||title), body=$('blBody').value.trim();
  if(!title||!slug||!body){ alert('blPushAlert','er','Headline, slug and body are all required.'); return; }
  const editing=!!blEditPath;
  const path=editing?blEditPath:`src/pages/blog/${slug}.md`;
  const btn=$('blPush'); btn.disabled=true; btn.textContent=editing?'Saving…':'Pushing…'; alert('blPushAlert','inf',(editing?'Saving ':'Pushing ')+path+'…');
  try{
    let sha, keepDraft=true;
    try{ const g=await ghApi('get',{path}); sha=g.sha; if(editing) keepDraft=isDraft(b64decode(g.content)); }catch(_){}
    let hero=$('blHero').value.trim();
    if(/^https?:\/\//i.test(hero)){ alert('blPushAlert','inf','Saving hero image into the repo…'); try{ const local=await hostHeroImage(hero,slug,'blog'); if(local) hero=local; }catch(e){ alert('blPushAlert','wr','Could not self-host the hero image ('+e.message+') — keeping the external URL.'); } }
    const date=(editing&&blEditDate)?blEditDate:new Date().toISOString().slice(0,10);
    const excerpt=deriveExcerpt(body);
    const fm=`---\nlayout: "../../layouts/BlogLayout.astro"\ntitle: ${yamlStr(title)}\ntopic: ${yamlStr($('blTopic').value.trim()||"Women's Sport")}\ndate: ${yamlStr(date)}\nauthor: ${yamlStr($('blAuthor').value||(team[0]&&team[0].name)||'')}\nexcerpt: ${yamlStr(excerpt)}\nmeta_description: ${yamlStr(excerpt)}\nhero_image: ${yamlStr(hero)}\nhero_credit: ${yamlStr(blHeroCredit)}\ndraft: ${keepDraft?'true':'false'}\n---\n\n${body}\n`;
    await ghApi('put',{path,content:b64(fm),message:`${editing?'Edit':'Add'} blog post: ${path}`,...(sha?{sha}:{})});
    alert('blPushAlert','ok',`${editing?'Saved':'Pushed'} ✓ ${keepDraft?'Draft':'Published'} — builds on the next deploy.`);
    $('blView').href=`/blog/${slug}/`; $('blView').style.display='inline-block';
    blLibLoaded=true; loadBlLib();
  }catch(e){ alert('blPushAlert','er','Push failed: '+e.message); }
  btn.disabled=false; btn.textContent=blEditPath?'Save changes →':'Push as draft →';
}

