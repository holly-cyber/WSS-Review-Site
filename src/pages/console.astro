// ---- Drag-to-reorder for the section cards ----
let emDrag=null;
function emBindGrip(grip){
  if(!grip) return;
  grip.addEventListener('dragstart',()=>{ emDrag=grip.closest('.em-sec'); if(emDrag) emDrag.classList.add('dragging'); });
  grip.addEventListener('dragend',()=>{ if(emDrag) emDrag.classList.remove('dragging'); emDrag=null; emRenderPreview(); });
}
function emInitDrag(){
  const cont=$('emSections'); if(!cont||cont.dataset.dragBound) return; cont.dataset.dragBound='1';
  cont.addEventListener('dragover',e=>{ if(!emDrag) return; e.preventDefault();
    const after=emDragAfter(cont,e.clientY);
    if(after==null) cont.appendChild(emDrag); else cont.insertBefore(emDrag,after);
  });
  cont.querySelectorAll('.em-grip').forEach(emBindGrip);
}
function emDragAfter(cont,y){
  let best=null,bestOff=-Infinity;
  cont.querySelectorAll('.em-sec:not(.dragging)').forEach(el=>{ const b=el.getBoundingClientRect(); const off=y-b.top-b.height/2; if(off<0&&off>bestOff){ bestOff=off; best=el; } });
  return best;
}
