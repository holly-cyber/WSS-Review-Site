// ---- Scores editor: adjust pillars → recompute overall + stars ----
const SCORE_LABELS={p1:'Inclusive Fit & Sizing',p2:'Functional Performance',p3:'Support Standards',p4:'Thermal & Materials',p5:'Female Design',p7:'Transparency',taste:'Taste & Texture (25%)',nutrition:'Nutrition (30%)',performance:'Performance (30%)',value:'Value (15%)',f1:'Female-Specific Last',f2:'Functional Performance',f3:'Fit Accuracy & Size',f4:'Female Biomechanics',f5:'Transparency',t1:'Female Data & Metrics',t2:'Hardware Fit',t3:'Functional Accuracy',t4:'Software & App',t5:'Transparency',e1:'Female-Specific Design',e2:'Functional Performance',e3:'Fit & Adjustability',e4:'Safety & Standards',e5:'Transparency',w1:'Female-Focused Suitability',w2:'Efficacy & Performance',w3:'Quality & Ingredients',w4:'Experience & Usability',w5:'Transparency & Value'};
// Weighted frameworks; anything not listed (apparel) = equal average of its pillars.
const SCORE_WEIGHTS={nutrition:{taste:25,nutrition:30,performance:30,value:15},footwear:{f1:25,f2:25,f3:20,f4:20,f5:10},technology:{t1:30,t2:20,t3:25,t4:15,t5:10},equipment:{e1:25,e2:25,e3:20,e4:20,e5:10},wellness:{w1:25,w2:30,w3:20,w4:15,w5:10}};
function edStars(ov){ const f=Math.round(Number(ov)||0); return '★'.repeat(Math.max(0,Math.min(5,f)))+'☆'.repeat(Math.max(0,5-f)); }
function renderEdScores(content){
  const {fm}=splitFrontmatter(content);
  const scores=parsePillarScores(fm), keys=Object.keys(scores);
  if(!keys.length){ $('edScores').innerHTML='<p class="hint" style="margin:0">This review has no pillar_scores block.</p>'; $('edOverall').textContent=''; return; }
  $('edScores').innerHTML=keys.map(k=>`<div class="ed-score-row"><label>${esc(SCORE_LABELS[k]||k)}</label><input type="number" min="1" max="5" step="0.5" data-key="${k}" value="${esc(String(scores[k]))}"></div>`).join('');
  edUpdateOverall();
}
function edUpdateOverall(){
  const pType=fmField(splitFrontmatter($('edBody').value).fm,'product_type');
  const ov=recalcOverall(parsePillarScores(splitFrontmatter($('edBody').value).fm), SCORE_WEIGHTS[pType]||null);
  $('edOverall').textContent=ov!=null?`— Overall ${ov.toFixed(1)} / 5  ${edStars(ov)}`:'';
}
$('edScores').addEventListener('input',e=>{
  const inp=e.target.closest('input[data-key]'); if(!inp) return;
  let v=Number(inp.value); if(isNaN(v)) return;
  v=Math.max(1,Math.min(5,v));
  let src=setPillarScore($('edBody').value, inp.dataset.key, v);
  const scores=parsePillarScores(splitFrontmatter(src).fm);
  const pType=fmField(splitFrontmatter(src).fm,'product_type');
  const ov=recalcOverall(scores, SCORE_WEIGHTS[pType]||null);
  if(ov!=null) src=setOverallScore(src, ov.toFixed(1));
  src=syncBodyScores(src, scores, ov);   // update the in-content stars/numbers too
  $('edBody').value=src;
  edUpdateOverall();
  clearTimeout(pvT); pvT=setTimeout(renderEdPreview,200);
});

