function emCfg(){ try{ return JSON.parse(localStorage.getItem('wssEmailCfg')||'{}'); }catch(_){ return {}; } }
function emSaveCfg(p){ try{ localStorage.setItem('wssEmailCfg', JSON.stringify({...emCfg(),...p})); }catch(_){ } }

async function emMlApi(action,payload){
  const r=await fetch(apiUrl('/api/mailerlite-campaign'),{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({action,payload})});
  const data=await r.json().catch(()=>({}));
  if(!r.ok) throw new Error(data.message||data.error||('HTTP '+r.status));
  return data;
}
function emBodyHtml(){
  const raw=$('emBody').value||'';
  let html = emFmt==='html' ? raw : mdToHtml(raw);
  // Safety net: turn any leftover Markdown-style [text](url) link into a real
  // <a> — even with a stray space before the "(", and even in HTML mode (where
  // Markdown isn't otherwise converted). Skips links already inside an href.
  html = html.replace(/\[([^\]\n]+)\]\s*\(\s*((?:https?:\/\/|mailto:)[^)\s]+)\s*\)/gi,
    (m,text,url)=>`<a href="${url.trim()}" style="color:#FF5E84;text-decoration:underline">${text.trim()}</a>`);
  return html;
}
function emOpts(forSend){
  return {
    theme: $('emTheme').value||'classic',
    body: emBodyHtml(),
    heroImage: forSend ? (emState.heroSend||'') : (emState.heroPreview||emState.heroSend||''),
    heroLink: ($('emHeroLink').value||'').trim(),
    heroAlt: ($('emSubject').value||'').trim(),
    ctaText: ($('emCtaText').value||'').trim(),
    ctaUrl: ($('emCtaUrl').value||'').trim(),
    preheader: ($('emPreheader').value||'').trim(),
    sections: emCollectSections(forSend),
  };
}
let emPvTimer=null;
function emRenderPreview(){
  clearTimeout(emPvTimer);
  emPvTimer=setTimeout(()=>{ const f=$('emPreview'); if(f) f.srcdoc=buildEmailHtml(emOpts(false)); },140);
}
// Host an uploaded file (dataURL) into the repo, return absolute deployed URL.
async function emHostUpload(dataUrl,ext){
  const base64=String(dataUrl).split(',')[1]||'';
  const clean=(ext||'jpg').replace(/[^a-z0-9]/gi,'').toLowerCase()||'jpg';
  const slug='email-'+Date.now();
  const path=`public/images/email/${slug}.${clean}`;
  await ghApi('put',{path,content:base64,message:`Add email hero image: ${path}`});
  return `${EM_SITE}/images/email/${slug}.${clean}`;
}

