}
// Insert a link into the body at the cursor — wraps the selected text, or
// prompts for the text if nothing is selected. Writes Markdown or an <a> tag to
// match the current body mode, so the user never types the syntax by hand.
function emInsertLink(){
  const ta=$('emBody'); if(!ta) return;
  const start=ta.selectionStart||0, end=ta.selectionEnd||0;
  let text=ta.value.slice(start,end).trim();
  if(!text){ text=(prompt('Link text (what the reader sees):','')||'').trim(); if(!text) return; }
  let url=(prompt('Link address (URL):','https://')||'').trim();
  if(!url||url==='https://') return;
  if(!/^(https?:|mailto:)/i.test(url)) url='https://'+url.replace(/^\/+/,'');
  const snippet = emFmt==='html' ? `<a href="${url}">${text}</a>` : `[${text}](${url})`;
  ta.value=ta.value.slice(0,start)+snippet+ta.value.slice(end);
  const pos=start+snippet.length; ta.focus(); try{ ta.setSelectionRange(pos,pos); }catch(_){ }
  emRenderPreview();
}
// Build a normalised {kind,title,hero,excerpt,url,date} from a nwLib/blLib item.
function emItemMeta(f,kind){
  let fm='',body=''; try{ const s=splitFrontmatter(f.content); fm=s.fm; body=s.body; }catch(_){ }
  const title=f.title||fmField(fm,'title')||f.slug;
  let hero=fmField(fm,'hero_image')||'';
  if(hero && !/^https?:\/\//i.test(hero)) hero=EM_SITE+(hero.charAt(0)==='/'?hero:'/'+hero);
  const excerpt=(fmField(fm,'excerpt')||fmField(fm,'meta_description')||deriveExcerpt(body)||'').trim();
  const url=kind==='review'
    ? EM_SITE+'/'+(f.category||fmField(fm,'category')||'')+'/'+f.slug+'/'
    : EM_SITE+(kind==='blog'?'/blog/':'/news/')+f.slug+'/';
  return {kind,title,hero,excerpt,url,date:f.date||fmField(fm,'date')||''};
}
// Reviews live in the console's `files` array; give each a parsed date so it
// sorts by recency like the blog/news libraries do.
function emReviews(){
  return (files||[]).filter(f=>f.draft===false && f.content).map(f=>{
    if(!f.date){ try{ f.date=fmField(splitFrontmatter(f.content).fm,'date')||''; }catch(_){ f.date=''; } }
    return f;
  }).sort((a,b)=>new Date(b.date||0)-new Date(a.date||0));
}
// Refresh the single-item picker + section checklists from reviews, blog & news.
function emRefreshItems(){
  const sel=$('emItemSel'); if(!sel) return;
  const byD=(a,b)=>new Date(b.date||0)-new Date(a.date||0);
  const reviews=emReviews();
  const blog=(blLib||[]).filter(f=>!f.draft).sort(byD);
  const news=(nwLib||[]).filter(f=>!f.draft).sort(byD);
  if(!reviews.length && !blog.length && !news.length){ sel.innerHTML='<option value="">Nothing published yet — open the Reviews/News/Blog tabs to load</option>'; }
  else{
    const opt=(f,kind,val)=>`<option value="${kind}:${esc(val)}">${esc(f.title||f.slug)}</option>`;
    sel.innerHTML=(reviews.length?`<optgroup label="Reviews">${reviews.map(f=>opt(f,'review',f.path)).join('')}</optgroup>`:'')
               +(blog.length?`<optgroup label="Blog">${blog.map(f=>opt(f,'blog',f.slug)).join('')}</optgroup>`:'')
               +(news.length?`<optgroup label="News">${news.map(f=>opt(f,'news',f.slug)).join('')}</optgroup>`:'');
  }
  // Section checklists — latest 8 of each, newest 3 pre-ticked.
  emRenderChecks('emRevList',reviews,f=>f.path);
  emRenderChecks('emBlogList',blog,f=>f.slug);
  emRenderChecks('emNewsList',news,f=>f.slug);
}
function emRenderChecks(boxId,list,valOf){
  const box=$(boxId); if(!box) return;
  const prev=new Set([...box.querySelectorAll('input:checked')].map(i=>i.value));
  const touched=box.dataset.touched==='1';
  if(!list.length){ box.innerHTML='<span class="em-hint2">Nothing published yet.</span>'; return; }
  // Render ALL items (sorted newest-first). Filtering hides rows without removing
  // them, so items ticked but not matching the filter stay selected.
  box.innerHTML=list.map((f,idx)=>{ const v=valOf(f);
    const d=f.date?new Date(f.date).toLocaleDateString('en-GB',{day:'numeric',month:'short'}):'';
    const on = touched ? prev.has(v) : idx<3;   // default: newest 3, unless the user has changed things
    const t=(f.title||f.slug||'').toLowerCase();
    return `<label data-t="${esc(t)}"><input type="checkbox" value="${esc(v)}"${on?' checked':''}/><span>${esc(f.title||f.slug)}${d?` <span class="emc-meta">· ${d}</span>`:''}</span></label>`;
  }).join('');
  if(!box.dataset.bound){ box.addEventListener('change',()=>{ box.dataset.touched='1'; }); box.dataset.bound='1'; }
  emFilterChecks(boxId);   // re-apply any active filter after a re-render
}
// Hide checklist rows that don't match the section's filter box (selection kept).
function emFilterChecks(boxId){
  const box=$(boxId); if(!box) return;
  const search=document.querySelector('.em-search[data-for="'+boxId+'"]');
  const q=((search&&search.value)||'').trim().toLowerCase();
  let shown=0;
  box.querySelectorAll('label').forEach(l=>{ const hit=!q||(l.dataset.t||'').includes(q); l.hidden=!hit; if(hit) shown++; });
  let none=box.querySelector('.em-checks-none');
  if(q && !shown){ if(!none){ none=document.createElement('div'); none.className='em-checks-none'; box.appendChild(none); } none.textContent='No matches for “'+q+'”.'; }
  else if(none){ none.remove(); }
}
// Gather the ticked items for one section into buildEmailHtml item shape.
function emSectionItems(kind){
  const box=$(kind==='review'?'emRevList':kind==='blog'?'emBlogList':'emNewsList'); if(!box) return [];
  return [...box.querySelectorAll('input:checked')].map(i=>{
    const f = kind==='review' ? (files||[]).find(x=>x.path===i.value)
                              : ((kind==='blog'?blLib:nwLib)||[]).find(x=>x.slug===i.value);
    if(!f) return null;
    const m=emItemMeta(f,kind); return {title:m.title,url:m.url,excerpt:m.excerpt.slice(0,150),image:m.hero};
  }).filter(Boolean);
}
// Walk the section cards in their (drag-reordered) DOM order, producing the
// sections array for buildEmailHtml. forSend picks the committed image URL for
// custom blocks (vs the instant preview URL).
const EM_FIXED={reviews:['emRevOn','emRevHead','review','Latest reviews','#000036'],
                blog:['emBlogOn','emBlogHead','blog','From the blog','#FF5E84'],
                news:['emNewsOn','emNewsHead','news','Latest news','']};
function emCollectSections(forSend){
  const cont=$('emSections'); if(!cont) return [];
  const out=[];
  for(const card of cont.children){
    const type=card.dataset.block;
    if(EM_FIXED[type]){
      const [onId,headId,kind,def,accent]=EM_FIXED[type];
      if($(onId)&&$(onId).checked){ const items=emSectionItems(kind); if(items.length) out.push({label:($(headId).value||def).trim(),items,accent:accent||undefined}); }
    }else if(type==='custom'){
      const id=card.dataset.id, st=emCustom[id]||{};
      const g=s=>card.querySelector(s);
      const heading=(g('.em-cust-head').value||'').trim();
      const text=(g('.em-cust-text').value||'').trim();
      const btnText=(g('.em-cust-btntext').value||'').trim();
      const btnUrl=(g('.em-cust-btnurl').value||'').trim();
      const image=forSend?(st.imgSend||''):(st.imgPreview||st.imgSend||'');
      if(heading||text||image||(btnText&&btnUrl)) out.push({custom:true,image,heading,html:text?mdToHtml(text):'',btnText,btnUrl,accent:'#FF5E84'});
    }
  }
  return out;
}
// ---- Email drafts: save the whole composition to the repo and re-open it ----
const EM_DRAFTS_PATH='src/data/email-drafts.json';
let emDrafts=[], emDraftsSha='', emCurrentDraftId='', emPendingGroup='';
function emGenId(){ return 'd'+Date.now().toString(36)+Math.random().toString(36).slice(2,6); }
const EM_SEC_IDS={reviews:['emRevOn','emRevHead','emRevList'],blog:['emBlogOn','emBlogHead','emBlogList'],news:['emNewsOn','emNewsHead','emNewsList']};
// Capture the full composer state (core fields + sections + custom blocks, in order).
function emSerialize(){
  const sections=[]; const cont=$('emSections');
  if(cont) for(const card of cont.children){
    const type=card.dataset.block;
    if(EM_SEC_IDS[type]){
      const [onId,headId,listId]=EM_SEC_IDS[type];
      const checked=[...($(listId)?$(listId).querySelectorAll('input:checked'):[])].map(i=>i.value);
      sections.push({type, on:$(onId)?$(onId).checked:false, head:$(headId)?$(headId).value:'', checked});
    }else if(type==='custom'){
      const st=emCustom[card.dataset.id]||{}; const g=s=>card.querySelector(s);
      sections.push({type:'custom', heading:g('.em-cust-head').value, text:g('.em-cust-text').value, btnText:g('.em-cust-btntext').value, btnUrl:g('.em-cust-btnurl').value, imgPreview:st.imgPreview||'', imgSend:st.imgSend||''});
    }
  }
  return { id:emCurrentDraftId||emGenId(), name:$('emName').value, subject:$('emSubject').value, preheader:$('emPreheader').value,
    fmt:emFmt, body:$('emBody').value, theme:$('emTheme').value,
    heroPreview:emState.heroPreview, heroSend:emState.heroSend, heroLink:$('emHeroLink').value,
    ctaText:$('emCtaText').value, ctaUrl:$('emCtaUrl').value,
    fromName:$('emFromName').value, from:$('emFrom').value, group:$('emGroup').value,
    sections, updatedAt:new Date().toISOString() };
}
// Rebuild the sections area (fixed cards reordered + custom cards recreated) from a saved list.
function emRestoreSections(sections){
  const cont=$('emSections'); if(!cont) return;
  [...cont.querySelectorAll('.em-sec[data-block="custom"]')].forEach(c=>c.remove()); emCustom={};
  const fixed={reviews:cont.querySelector('.em-sec[data-block="reviews"]'),blog:cont.querySelector('.em-sec[data-block="blog"]'),news:cont.querySelector('.em-sec[data-block="news"]')};
