function scFindRaw(value){
  const i=String(value||'').indexOf(':'); if(i<0) return null;
  const kind=value.slice(0,i), ref=value.slice(i+1);
  const f = kind==='review' ? (files||[]).find(x=>x.path===ref) : ((kind==='blog'?blLib:nwLib)||[]).find(x=>x.slug===ref);
  return f?{f,kind}:null;
}
// A longer plain-text snippet of the item body for the caption.
function scSnippet(f,max){ max=max||300;
  let body=''; try{ body=splitFrontmatter(f.content).body||''; }catch(_){ }
  let txt=body.replace(/```[\s\S]*?```/g,' ').replace(/<[^>]+>/g,' ')
    .replace(/!\[[^\]]*\]\([^)]*\)/g,' ').replace(/\[([^\]]+)\]\([^)]*\)/g,'$1')
    .replace(/^\s{0,3}#{1,6}\s+.*$/gm,' ').replace(/[*_`>|]/g,'').replace(/\s+/g,' ').trim();
  if(txt.length>max) txt=txt.slice(0,max).replace(/\s+\S*$/,'')+'…';
  return txt;
}
function scBuildFromItem(){
  const r=scFindRaw($('scItemSel').value);
  if(!r){ alert('scAlert','er','Pick a review or post first.'); return; }
  const m=emItemMeta(r.f,r.kind);
  $('scHeadline').value=m.title;
  $('scDesc').value=(m.excerpt||'').slice(0,90);
  $('scEyebrow').value=r.kind==='review'?'WSS™ Review':r.kind==='blog'?'WSS™ Blog':'WSS™ News';
  const snip=scSnippet(r.f,300)||m.excerpt||'';
  const cta=r.kind==='review'?'Read the full review':'Read more';
  $('scCaption').value=`${m.title}\n\n${snip}\n\n${cta}: ${m.url}`;
  alert('scAlert','ok','Built from “'+esc(m.title)+'”. Tweak the text and image, then download.');
  if(m.hero) scSetImage(m.hero); else scDraw();
}
function scUseImgUrl(){ const url=($('scImgUrl').value||'').trim(); if(!/^https?:\/\//i.test(url)){ $('scImgStatus').innerHTML='<span style="color:#c00">Enter a valid image URL.</span>'; return; } scSetImage(url); }
function scUseImgFile(e){ const file=e.target.files&&e.target.files[0]; if(!file) return; if(file.size>10*1024*1024){ $('scImgStatus').innerHTML='<span style="color:#c00">Image over 10MB — use a smaller file.</span>'; return; } const reader=new FileReader(); reader.onload=()=>scSetImage(reader.result); reader.readAsDataURL(file); }
async function scSetImage(url){
  $('scImgStatus').textContent='Loading image…';
  try{ scImg=await scLoadImage(url); $('scImgStatus').innerHTML='<span style="color:#0a7a33">✓ Image loaded.</span>'; }
  catch(err){ $('scImgStatus').innerHTML='<span style="color:#c00">Could not load image: '+esc(err.message)+'</span>'; }
  scDraw();
}
// Load into an Image. External URLs go via /api/image-fetch (→ same-origin data
// URI) so the canvas is never tainted and can be exported/downloaded.
function scLoadImage(url){
  return new Promise((resolve,reject)=>{
    const finish=(src)=>{ const img=new Image(); img.onload=()=>resolve(img); img.onerror=()=>reject(new Error('image failed to load')); img.src=src; };
    if(/^data:/i.test(url)) return finish(url);
    if(/^https?:\/\//i.test(url)){
      fetch(apiUrl('/api/image-fetch'),{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({url})})
        .then(r=>r.json()).then(d=>{ if(d&&d.ok&&d.base64) finish('data:'+(d.contentType||'image/jpeg')+';base64,'+d.base64); else reject(new Error((d&&d.error)||'fetch failed')); })
        .catch(e=>reject(e));
    } else finish(url);
  });
}
function scWrap(ctx,text,maxW){
  const words=String(text||'').split(/\s+/).filter(Boolean); const lines=[]; let line='';
  for(const w of words){ const t=line?line+' '+w:w; if(ctx.measureText(t).width>maxW && line){ lines.push(line); line=w; } else line=t; }
  if(line) lines.push(line); return lines;
}
function scRoundRect(ctx,x,y,w,h,r){ ctx.beginPath(); ctx.moveTo(x+r,y); ctx.arcTo(x+w,y,x+w,y+h,r); ctx.arcTo(x+w,y+h,x,y+h,r); ctx.arcTo(x,y+h,x,y,r); ctx.arcTo(x,y,x+w,y,r); ctx.closePath(); }
function scDraw(){
  const canvas=$('scCanvas'); if(!canvas) return; const ctx=canvas.getContext('2d');
  const [W,H]=SC_SIZES[($('scSize')||{}).value]||SC_SIZES.portrait;
  canvas.width=W; canvas.height=H;
  ctx.fillStyle='#0b1f3a'; ctx.fillRect(0,0,W,H);
  if(scImg){ const s=Math.max(W/scImg.width,H/scImg.height); const dw=scImg.width*s, dh=scImg.height*s; ctx.drawImage(scImg,(W-dw)/2,(H-dh)/2,dw,dh); }
  else{ ctx.fillStyle='rgba(255,255,255,.45)'; ctx.textAlign='center'; ctx.font=`500 ${Math.round(W*0.03)}px Poppins, sans-serif`; ctx.fillText('Add an image →',W/2,H/2); ctx.textAlign='left'; }
  const g=ctx.createLinearGradient(0,H*0.30,0,H);
  g.addColorStop(0,'rgba(0,0,54,0)'); g.addColorStop(0.55,'rgba(0,0,54,0.45)'); g.addColorStop(1,'rgba(0,0,54,0.94)');
  ctx.fillStyle=g; ctx.fillRect(0,0,W,H);
  const pad=Math.round(W*0.075);
  // Eyebrow pill
  const eb=($('scEyebrow').value||'').trim().toUpperCase();
  if(eb){ ctx.font=`700 ${Math.round(W*0.026)}px Poppins, sans-serif`; const tw=ctx.measureText(eb).width; const ph=Math.round(W*0.058), pw=tw+Math.round(W*0.05);
    ctx.fillStyle='#FF5E84'; scRoundRect(ctx,pad,pad,pw,ph,ph/2); ctx.fill();
    ctx.fillStyle='#fff'; ctx.textBaseline='middle'; ctx.fillText(eb,pad+Math.round(W*0.025),pad+ph/2+1); ctx.textBaseline='alphabetic'; }
  // Headline + description, anchored to the bottom
  const headline=($('scHeadline').value||'').trim(), desc=($('scDesc').value||'').trim();
  const maxW=W-pad*2, hlSize=Math.round(W*0.072), hlLH=Math.round(hlSize*1.12), dSize=Math.round(W*0.036), dLH=Math.round(dSize*1.35), gap=Math.round(W*0.022);
  ctx.font=`700 ${hlSize}px Poppins, sans-serif`; const hlLines=scWrap(ctx,headline,maxW).slice(0,4);
  ctx.font=`400 ${dSize}px Poppins, sans-serif`; const dLines=desc?scWrap(ctx,desc,maxW).slice(0,3):[];
  const blockH=hlLines.length*hlLH + (dLines.length?gap+dLines.length*dLH:0);
  let ty=H-pad-blockH; ctx.textBaseline='top';
  ctx.fillStyle='#fff'; ctx.font=`700 ${hlSize}px Poppins, sans-serif`;
  for(const ln of hlLines){ ctx.fillText(ln,pad,ty); ty+=hlLH; }
  if(dLines.length){ ty+=gap; ctx.fillStyle='rgba(255,255,255,.9)'; ctx.font=`400 ${dSize}px Poppins, sans-serif`; for(const ln of dLines){ ctx.fillText(ln,pad,ty); ty+=dLH; } }
  ctx.textBaseline='alphabetic';
}
function scDownloadImg(){
  const canvas=$('scCanvas'); if(!canvas) return;
  try{
    canvas.toBlob(blob=>{ if(!blob){ alert('scAlert','er','Could not export the image (the source photo blocked it). Try re-adding the image.'); return; }
      const a=document.createElement('a'); a.href=URL.createObjectURL(blob);
      const nm=(($('scHeadline').value||'wss-social').toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/^-+|-+$/g,'')||'wss-social').slice(0,50);
      a.download=nm+'.png'; document.body.appendChild(a); a.click(); a.remove(); setTimeout(()=>URL.revokeObjectURL(a.href),3000);
      alert('scAlert','ok','Image downloaded ✓');
    },'image/png');
  }catch(e){ alert('scAlert','er','Could not export the image: '+esc(e.message)); }
}
async function scCopyCaption(){
  try{ await navigator.clipboard.writeText($('scCaption').value||''); alert('scAlert','ok','Caption copied ✓'); }
  catch(_){ alert('scAlert','wr','Could not copy automatically — select the caption text and copy it manually.'); }
}
async function scCheckConn(){
  const btn=$('scCheck'); const orig=btn.textContent; btn.disabled=true; btn.textContent='Checking…'; alert('scPubAlert','inf','Checking Meta connection…');
  try{
    const r=await fetch(apiUrl('/api/social-status')); const d=await r.json().catch(()=>({}));
    const line=(label,c,idVar,tokVar)=>{
      if(!c) return `• ${label}: —`;
      if(c.ok) return `✓ ${label}: connected${c.name?' ('+esc(c.name)+')':c.username?' (@'+esc(c.username)+')':''}`;
      const miss=[]; const hasId=('hasPageId'in c)?c.hasPageId:c.hasUserId;
      if(!hasId) miss.push(idVar); if(!c.hasToken) miss.push(tokVar);
      if(miss.length) return `✗ ${label}: not set — add ${miss.join(' &amp; ')} in Netlify`;
      return `✗ ${label}: token rejected — ${esc(c.error||'not connected')}`;
    };
    const fb=line('Facebook',d.facebook,'FB_PAGE_ID','FB_PAGE_ACCESS_TOKEN');
    const ig=line('Instagram',d.instagram,'IG_USER_ID','IG_ACCESS_TOKEN');
    const good=(d.facebook&&d.facebook.ok)||(d.instagram&&d.instagram.ok);
    alert('scPubAlert', good?'ok':'wr', fb+'<br>'+ig);
  }catch(e){ alert('scPubAlert','er','Check failed: '+esc(e.message)); }
  btn.disabled=false; btn.textContent=orig;
}
async function scPublish(){
  const targets=[]; if($('scTgIg').checked) targets.push('instagram'); if($('scTgFb').checked) targets.push('facebook');
  if(!targets.length){ alert('scPubAlert','er','Pick Instagram, Facebook, or both.'); return; }
  if(!scImg){ alert('scPubAlert','er','Add an image first.'); return; }
  if(targets.includes('instagram') && ($('scSize')||{}).value==='story'){ alert('scPubAlert','wr','Instagram feed posts don’t allow the tall 9:16 Story shape — pick Portrait 4:5 or Square for Instagram. (Facebook accepts any shape.)'); return; }
  const canvas=$('scCanvas'); let dataUrl;
  try{ dataUrl=canvas.toDataURL('image/jpeg',0.92); }
  catch(e){ alert('scPubAlert','er','Could not read the image (the source photo blocked export) — re-add the image and try again.'); return; }
  const caption=$('scCaption').value||'';
  const captions={ facebook:caption, instagram: scCaptionFor('instagram') };
  const names=targets.map(t=>t==='instagram'?'Instagram':'Facebook').join(' + ');
  if(!confirm('Publish this post now to '+names+'?\n\nThis posts live to your channel(s).')) return;
  const btn=$('scPublish'); const orig=btn.textContent; btn.disabled=true; btn.textContent='Publishing…'; alert('scPubAlert','inf','Publishing to '+names+'…');
  try{
    const r=await fetch(apiUrl('/api/social-publish'),{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({targets,imageBase64:dataUrl,caption,captions})});
    const d=await r.json().catch(()=>({}));
    const res=d.results||{};
    const parts=targets.map(t=>{ const label=t==='instagram'?'Instagram':'Facebook'; const x=res[t];
      if(x&&x.ok) return `✓ ${label} published${x.permalink?` — <a href="${x.permalink}" target="_blank">view</a>`:''}`;
      return `✗ ${label}: ${esc((x&&x.error)||d.error||('HTTP '+r.status))}`; });
    const anyOk=targets.some(t=>res[t]&&res[t].ok), anyFail=parts.some(p=>p.indexOf('✗')===0);
    alert('scPubAlert', anyOk?(anyFail?'wr':'ok'):'er', parts.join('<br>'));
  }catch(e){ alert('scPubAlert','er','Publish failed: '+esc(e.message)); }
  btn.disabled=false; btn.textContent=orig;
}
// Build the caption for a given channel. Instagram can't have clickable links,
// so (when the toggle is on) any URL is dropped and, if one was present, a
// "Link in bio" line is appended. Facebook keeps the caption as written.
function scCaptionFor(channel){
  const raw=$('scCaption').value||'';
  if(channel!=='instagram' || !($('scIgBio')&&$('scIgBio').checked)) return raw;
  const hadUrl=/https?:\/\/\S+/i.test(raw);
  let out=raw
    .replace(/https?:\/\/\S+/gi,'')                                   // links aren't clickable on IG
    .replace(/^\s*(read (the )?(full )?(review|post|story)|read more|link|shop|buy( now)?)\s*[:\-–—]?\s*$/gim,'') // now-empty CTA labels
    .replace(/[ \t]+$/gm,'').replace(/\n{3,}/g,'\n\n').trim();
  if(hadUrl) out=(out?out+'\n\n':'')+'🔗 Link in bio';
  return out;
}
function scRenderCapPreview(){
  const box=$('scCapPreviewBox'); if(!box) return;
  const fb=$('scCaption').value||'', ig=scCaptionFor('instagram');
  box.innerHTML=`<div style="border:1px solid #ececf1;border-radius:8px;padding:8px 10px;margin-bottom:6px"><strong>📘 Facebook</strong><div style="white-space:pre-wrap;color:#444;margin-top:4px">${esc(fb)||'<em>(empty)</em>'}</div></div>`
    +`<div style="border:1px solid #ececf1;border-radius:8px;padding:8px 10px"><strong>📸 Instagram</strong><div style="white-space:pre-wrap;color:#444;margin-top:4px">${esc(ig)||'<em>(empty)</em>'}</div></div>`;
}
function scInsertLink(){
  const ta=$('scCaption'); if(!ta) return;
  const s=ta.selectionStart||0,e=ta.selectionEnd||0; const text=ta.value.slice(s,e).trim();
  let url=(prompt('Link address (URL):','https://')||'').trim(); if(!url||url==='https://') return;
  if(!/^(https?:|mailto:)/i.test(url)) url='https://'+url.replace(/^\/+/,'');
  const snippet=text?`${text}: ${url}`:url;   // captions are plain text — raw URLs are clickable on Facebook
  ta.value=ta.value.slice(0,s)+snippet+ta.value.slice(e); const pos=s+snippet.length; ta.focus(); try{ ta.setSelectionRange(pos,pos); }catch(_){ }
}
async function scAiCaption(){
  const btn=$('scAiBtn'); btn.disabled=true; btn.textContent='Writing…';
  try{
    const sys='You are the WomensSportsStore.com social copywriter. Voice: expert, warm, a little sassy; British English; never "pink it and shrink it". Write ONE Instagram/Facebook caption in plain text (no markdown, no asterisks). Hook on the first line, then 2-4 short lines, a clear call to action, then up to 5 relevant hashtags on the final line. Under 120 words. Output only the caption.';
    const brief=($('scAiBrief').value||'').trim();
    const content=`Headline: ${$('scHeadline').value||''}\nDescription: ${$('scDesc').value||''}\nSnippet/current caption: ${$('scCaption').value||''}\nExtra direction: ${brief||'(none)'}`;
    await aiStream({ system:sys, max_tokens:500, messages:[{role:'user',content}], onText:(t)=>{ $('scCaption').value=t; } });
  }catch(e){ alert('scAlert','er','AI caption failed: '+esc(e.message)); }
  btn.disabled=false; btn.textContent='Write with AI';
}

