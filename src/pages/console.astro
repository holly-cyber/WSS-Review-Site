function setNwTab(name){
  document.querySelectorAll('#view-news .nw-tab').forEach(b=>b.classList.toggle('active',b.dataset.nwtab===name));
  document.querySelectorAll('#view-news .nwtab').forEach(t=>{ t.hidden = t.id!=='nwtab-'+name; });
}
document.querySelectorAll('#view-news .nw-tab').forEach(b=>b.addEventListener('click',()=>setNwTab(b.dataset.nwtab)));

// --- RSS feed manager: reads/writes src/data/feeds.json via GitHub ---
let nwFeeds=feeds.slice(), nwFeedsSha='';
function setNwFeedsAlert(t,m){ $('nwFeedsAlert').innerHTML=m?`<div class="al ${t}">${m}</div>`:''; }
function renderNwFeeds(){
  $('nwFeedsCount').textContent=nwFeeds.length||'';
  if(!nwFeeds.length){ $('nwFeedsList').innerHTML='<p class="nw-lib-empty">No feeds yet — add one below.</p>'; return; }
  $('nwFeedsList').innerHTML=
    `<div class="nw-feed-tools"><label><input type="checkbox" id="nwFeedAll" checked> Refresh all</label><span id="nwFeedPickCount" class="nw-feed-pickcount"></span></div>`+
    nwFeeds.map((f,i)=>`<div class="nw-feed-item"><input type="checkbox" class="nw-feed-pick" data-i="${i}" checked title="Include this feed when refreshing"><div class="nw-feed-main"><strong>${esc(f.name||f.url)}</strong>${f.tag?`<span class="nw-feed-tag">${esc(f.tag)}</span>`:''}<div class="nw-feed-url">${esc(f.url)}</div></div><button class="bg bdanger" data-del="${i}" style="padding:4px 10px">Remove</button></div>`).join('');
  updateFeedPickCount();
}
function selectedFeeds(){
  const boxes=[...document.querySelectorAll('.nw-feed-pick')];
  if(!boxes.length) return nwFeeds.slice();   // panel not rendered yet → treat as all
  const idx=new Set(boxes.filter(c=>c.checked).map(c=>parseInt(c.dataset.i)));
  return nwFeeds.filter((f,i)=>idx.has(i));
}
function updateFeedPickCount(){
  const n=selectedFeeds().length, t=nwFeeds.length;
  const el=$('nwFeedPickCount'); if(el) el.textContent=`${n}/${t} selected`;
  const all=$('nwFeedAll'); if(all) all.checked=(n===t && t>0);
  const rb=$('nwRefresh'); if(rb) rb.textContent=n<t?`↻ Refresh ${n} feed${n===1?'':'s'}`:'↻ Refresh feeds';
}
$('nwFeedsList').addEventListener('change',e=>{
  if(e.target.id==='nwFeedAll'){ document.querySelectorAll('.nw-feed-pick').forEach(c=>{ c.checked=e.target.checked; }); updateFeedPickCount(); }
  else if(e.target.classList.contains('nw-feed-pick')){ updateFeedPickCount(); }
});
async function loadNwFeeds(){
  try{ const g=await ghApi('get',{path:'src/data/feeds.json'}); nwFeedsSha=g.sha; const arr=JSON.parse(b64decode(g.content)); if(Array.isArray(arr)) nwFeeds=arr; }
  catch(e){ nwFeeds=feeds.slice(); nwFeedsSha=''; }   // fall back to bundled defaults
  renderNwFeeds(); renderNwTags();
}
async function saveNwFeeds(message){
  setNwFeedsAlert('inf','Saving feeds…');
  try{
    if(!nwFeedsSha){ try{ const g=await ghApi('get',{path:'src/data/feeds.json'}); nwFeedsSha=g.sha; }catch(_){ } }
    const r=await ghApi('put',{path:'src/data/feeds.json',content:b64(JSON.stringify(nwFeeds,null,2)+'\n'),message,...(nwFeedsSha?{sha:nwFeedsSha}:{})});
    nwFeedsSha=(r.content&&r.content.sha)||nwFeedsSha;
    setNwFeedsAlert('ok','Saved ✓ Feeds updated in the repo.');
  }catch(e){ setNwFeedsAlert('er','Could not save: '+e.message); }
}
$('nwFeedsList').addEventListener('click',e=>{
  const del=e.target.closest('[data-del]'); if(!del) return;
  const i=parseInt(del.dataset.del), f=nwFeeds[i]; if(!f) return;
  if(!confirm('Remove this feed?\n\n'+(f.name||f.url))) return;
  nwFeeds.splice(i,1); renderNwFeeds(); renderNwTags(); saveNwFeeds('Remove RSS feed: '+(f.name||f.url));
});
function nwAddFeed(){
  const name=$('nwFeedName').value.trim(), url=$('nwFeedUrl').value.trim(), tag=$('nwFeedTag').value.trim();
  if(!/^https?:\/\//i.test(url)){ setNwFeedsAlert('er','Enter a full feed URL starting with http(s)://'); return; }
  if(nwFeeds.some(f=>(f.url||'').toLowerCase()===url.toLowerCase())){ setNwFeedsAlert('wr','That feed URL is already in the list.'); return; }
  const entry={name:name||url.replace(/^https?:\/\//,'').split('/')[0], url}; if(tag) entry.tag=tag;
  nwFeeds.push(entry); renderNwFeeds(); renderNwTags();
  $('nwFeedName').value=$('nwFeedUrl').value=$('nwFeedTag').value='';
  saveNwFeeds('Add RSS feed: '+entry.name);
}
$('nwFeedAdd').addEventListener('click',nwAddFeed);
$('nwFeedUrl').addEventListener('keydown',e=>{ if(e.key==='Enter'){ e.preventDefault(); nwAddFeed(); } });

// --- News article library: existing drafts + published, with manage actions ---
let nwLib=[];
let nwUsedLinks=new Set();  // source URLs already used by an existing article
const normLink=(u)=>String(u||'').trim().toLowerCase().replace(/^https?:\/\//,'').replace(/^www\./,'').replace(/\/+$/,'');
$('nwLibReload').addEventListener('click',loadNwLib);
async function loadNwLib(){
  $('nwLibDrafts').innerHTML=$('nwLibPublished').innerHTML='<p style="color:#999;font-size:13px;padding:4px">Loading…</p>';
  setNwLibAlert('','');
  try{
    const d=await ghApi('tree',{});
    const files=(d.tree||[]).filter(t=>t.type==='blob'&&/^src\/pages\/news\/.+\.md$/.test(t.path));
    nwLib=files.map(t=>({path:t.path,slug:t.path.split('/').pop().replace('.md',''),sha:'',content:'',draft:false}));
    await Promise.all(nwLib.map(async f=>{
      try{ const g=await ghApi('get',{path:f.path}); f.sha=g.sha; f.content=b64decode(g.content);
        const {fm}=splitFrontmatter(f.content);
        f.title=fmField(fm,'title')||f.slug; f.date=fmField(fm,'date'); f.author=fmField(fm,'author'); f.draft=isDraft(f.content);
      }catch(_){ }
    }));
    // Collect every source URL we've already used, so feeds can skip them.
    nwUsedLinks=new Set();
    for(const f of nwLib){ try{ for(const s of parseNwSources(splitFrontmatter(f.content).fm)) if(s.link) nwUsedLinks.add(normLink(s.link)); }catch(_){ } }
    renderNwLib(); renderDashboard();
  }catch(e){ $('nwLibDrafts').innerHTML=$('nwLibPublished').innerHTML=`<p style="color:#c00;font-size:13px;padding:4px">Could not load: ${esc(e.message)}</p>`; }
}
function setNwLibAlert(type,msg){ $('nwLibAlert').innerHTML=msg?`<div class="al ${type}">${msg}</div>`:''; }
function byDateDesc(a,b){ return new Date(b.date||0)-new Date(a.date||0); }
function nwLibRow(f){
  const d=f.date?new Date(f.date).toLocaleDateString('en-GB',{day:'numeric',month:'short',year:'numeric'}):'';
  return `<div class="nw-lib-row" data-path="${esc(f.path)}"><div><div class="nw-lib-title">${esc(f.title||f.slug)}</div><div class="nw-lib-meta">${esc(f.author||'—')}${d?' · '+d:''} · ${esc(f.slug)}</div></div><div class="nw-lib-acts"><button class="bg" data-act="edit">Edit</button><button class="bg" data-act="preview">Preview</button><button class="bg" data-act="toggle">${f.draft?'Publish':'Unpublish'}</button><button class="bg bdanger" data-act="delete">Delete</button></div></div>`;
}
function renderNwLib(){
  const drafts=nwLib.filter(f=>f.draft).sort(byDateDesc), live=nwLib.filter(f=>!f.draft).sort(byDateDesc);
  $('nwLibDrafts').innerHTML=drafts.length?drafts.map(nwLibRow).join(''):'<p class="nw-lib-empty">No draft articles. Generate one in the Generate tab.</p>';
  $('nwLibPublished').innerHTML=live.length?live.map(nwLibRow).join(''):'<p class="nw-lib-empty">Nothing published yet.</p>';
  $('nwCountDrafts').textContent=drafts.length||'';
  $('nwCountPublished').textContent=live.length||'';
}
async function onNwLibClick(e){
  const btn=e.target.closest('[data-act]'), row=e.target.closest('[data-path]'); if(!btn||!row) return;
  const f=nwLib.find(x=>x.path===row.dataset.path); if(!f) return;
  const act=btn.dataset.act;
  if(act==='preview') openNwPreview(f.content);
  else if(act==='toggle') toggleNwDraft(f);
  else if(act==='delete') deleteNwArticle(f);
  else if(act==='edit') editNwArticle(f);
}
$('nwLibDrafts').addEventListener('click',onNwLibClick);
$('nwLibPublished').addEventListener('click',onNwLibClick);
$('nwLibReload2').addEventListener('click',loadNwLib);
function newsPreviewHtml(md){
  const {fm,body}=splitFrontmatter(md); const f=n=>fmField(fm,n);
  const hero=f('hero_image'), title=f('title')||'Untitled', author=f('author'), date=f('date');
  const dl=date?new Date(date).toLocaleDateString('en-GB',{day:'numeric',month:'long',year:'numeric'}):'';
  return `<div class="pv-content" style="padding:18px">${hero?`<img src="${esc(hero)}" style="width:100%;border-radius:8px;margin-bottom:12px" alt=""/>`:''}<h1 style="font-size:24px;color:#000036;margin:0 0 6px;line-height:1.2">${esc(title)}</h1><div style="color:#888;font-size:13px;margin-bottom:12px">${esc(author||'')}${author&&dl?' · ':''}${esc(dl)}</div>${mdToHtml(body)}</div>`;
}
function openNwPreview(md){ $('pvBody').innerHTML=newsPreviewHtml(md); $('pvOv').classList.add('show'); }
async function toggleNwDraft(f){
  const makeDraft=!f.draft;
  setNwLibAlert('inf',(makeDraft?'Unpublishing…':'Publishing…'));
  try{
    const g=await ghApi('get',{path:f.path}); const upd=setDraftFlag(b64decode(g.content),makeDraft);
    const r=await ghApi('put',{path:f.path,content:b64(upd),message:`${makeDraft?'Unpublish':'Publish'} news: ${f.path}`,sha:g.sha});
    f.content=upd; f.sha=(r.content&&r.content.sha)||g.sha; f.draft=makeDraft; renderNwLib();
    setNwLibAlert('ok',`${makeDraft?'Set to draft':'Published'} ✓ Redeploys within ~60s.`);
  }catch(e){ setNwLibAlert('er','Could not update: '+e.message); }
}
async function deleteNwArticle(f){
  if(!confirm('Delete this news article permanently?\n\n'+f.path)) return;
  setNwLibAlert('inf','Deleting…');
  try{
    const g=await ghApi('get',{path:f.path}); await ghApi('delete',{path:f.path,message:`Delete news: ${f.path}`,sha:g.sha});
    nwLib=nwLib.filter(x=>x.path!==f.path); renderNwLib(); setNwLibAlert('ok','Deleted ✓ Disappears on the next deploy.');
  }catch(e){ setNwLibAlert('er','Delete failed: '+e.message); }
}
function parseNwSources(fm){
  // sources: is the last frontmatter key in generated files, so capture to the
  // end and pull title/url pairs (non-pair trailing lines are simply ignored).
  const m=fm.match(/(?:^|\n)sources:[ \t]*\n([\s\S]*)$/);
  if(!m) return [];
  const out=[]; const re=/-[ \t]*title:[ \t]*"((?:[^"\\]|\\.)*)"[ \t]*\n[ \t]*url:[ \t]*"((?:[^"\\]|\\.)*)"/g; let x;
  while((x=re.exec(m[1]))) out.push({title:x[1].replace(/\\"/g,'"'),link:x[2].replace(/\\"/g,'"')});
  return out;
}
function editNwArticle(f){
  const {fm,body}=splitFrontmatter(f.content); const g=n=>fmField(fm,n);
  nwEditPath=f.path; nwEditDate=g('date'); nwEditSources=parseNwSources(fm); nwLastItems=nwEditSources||[];
  $('nwTitle').value=g('title')||f.slug;
  $('nwSlug').value=f.slug; $('nwSlug').readOnly=true;
  $('nwTopic').value=g('topic')||'';
  $('nwHero').value=g('hero_image')||''; nwHeroCredit=g('hero_credit')||'';
  $('nwBody').value=body.trim();
  const a=g('author'); if(a){ const sel=$('nwAuthor'); if([...sel.options].some(o=>o.value===a)) sel.value=a; }
  nwHeroImgs=[]; $('nwHeroGrid').innerHTML=''; $('nwHeroNote').style.display='none';
  setNwTab('generate');
  $('nwOutPanel').style.display='block';
  renderNwPreview();
  $('nwPush').textContent='Save changes →';
  alert('nwPushAlert','inf',`Editing “${esc(f.slug)}” — Save changes to commit.`);
  $('nwOutPanel').scrollIntoView({behavior:'smooth',block:'start'});
}

$('nwRefresh').addEventListener('click',refreshFeeds);
$('nwSelClear').addEventListener('click',()=>{ nwSel=[]; document.querySelectorAll('#nwItems input[type=checkbox]').forEach(c=>c.checked=false); updateNwSel(); });

let nwResults=[], nwActiveTag='', nwSearchT=null;
const NW_MAX_AGE_DAYS=7;   // freshness window: only pull stories from the last N days

async function refreshFeeds(){
  if(!nwFeeds.length){ alert('newsAlert','wr','No RSS feeds configured — add one in the RSS feeds panel above.'); return; }
  const sources=selectedFeeds();
  if(!sources.length){ alert('newsAlert','wr','No feeds selected — tick at least one feed in the RSS feeds panel.'); return; }
  const btn=$('nwRefresh'); btn.disabled=true; btn.textContent='Fetching…';
  alert('newsAlert','inf','Fetching '+sources.length+' feed(s)…');
  try{
    const r=await fetch(apiUrl('/api/rss-proxy'),{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({sources})});
    const data=await r.json().catch(()=>({}));
    if(!r.ok) throw new Error(data.message||('HTTP '+r.status));
    nwResults=data.results||[]; nwAllItems=[]; nwSel=[];
    const cutoff=Date.now()-NW_MAX_AGE_DAYS*86400000;   // only the last N days
    let nwHidden=0, nwStaleAge=0; const staleFeeds=[];
    for(const rr of nwResults){
      const feedWomen=isWomensFeed((rr.name||'')+' '+(rr.tag||''));   // women-dedicated feed → all items relevant
      let newest=0;
      for(const it of (rr.items||[])){
        if(it.ts) newest=Math.max(newest,it.ts);
        if(it.link && nwUsedLinks.has(normLink(it.link))){ nwHidden++; continue; }   // skip articles we've used before
        if(it.ts && it.ts<cutoff){ nwStaleAge++; continue; }   // older than the freshness window
        const women=feedWomen||isWomensContent((it.title||'')+' '+(it.summary||''));
        nwAllItems.push({title:it.title,link:it.link,summary:it.summary,date:it.date,ts:it.ts,source:rr.name,tag:rr.tag||'',women});
      }
      if(rr.ok && newest && newest<cutoff) staleFeeds.push(rr.name);   // newest dated story is older than the window
    }
    renderNwTags();
    $('nwFilterBar').style.display=nwAllItems.length?'flex':'none';
    applyNwFilter();
    const ok=nwResults.filter(x=>x.ok).length;
    const extra=`${nwHidden?` · ${nwHidden} already-used hidden`:''}${nwStaleAge?` · ${nwStaleAge} older than ${NW_MAX_AGE_DAYS} days`:''}`;
    const staleMsg=staleFeeds.length?` ⚠ No stories in the last ${NW_MAX_AGE_DAYS} days from: ${staleFeeds.join(', ')}.`:'';
    alert('newsAlert',staleFeeds.length?'wr':'ok',`Loaded ${nwAllItems.length} recent stor${nwAllItems.length===1?'y':'ies'} (last ${NW_MAX_AGE_DAYS} days) from ${ok}/${sources.length} feed(s)${extra}.${staleMsg}`);
  }catch(e){ alert('newsAlert','er','Could not fetch feeds: '+e.message+' (the rss-proxy function needs to be deployed on Netlify).'); }
  btn.disabled=false; btn.textContent='↻ Refresh feeds'; updateFeedPickCount();
}

// --- Tag + keyword filtering over the pulled stories ---
function nwTagList(){ const s=new Set(); nwFeeds.forEach(f=>f.tag&&s.add(f.tag)); nwResults.forEach(r=>r.tag&&s.add(r.tag)); return [...s].sort(); }
function renderNwTags(){
  $('nwTags').innerHTML=[`<span class="nw-tag${nwActiveTag===''?' active':''}" data-tag="">All</span>`]
    .concat(nwTagList().map(t=>`<span class="nw-tag${nwActiveTag===t?' active':''}" data-tag="${esc(t)}">${esc(t)}</span>`)).join('');
}
$('nwTags').addEventListener('click',e=>{ const c=e.target.closest('[data-tag]'); if(!c) return; nwActiveTag=c.dataset.tag; renderNwTags(); applyNwFilter(); });
$('nwSearch').addEventListener('input',()=>{ clearTimeout(nwSearchT); nwSearchT=setTimeout(applyNwFilter,180); });
$('nwWomenOnly').addEventListener('change',applyNwFilter);

function applyNwFilter(){
  const terms=($('nwSearch').value||'').trim().toLowerCase().split(/\s+/).filter(Boolean);
  const womenOnly=$('nwWomenOnly')?$('nwWomenOnly').checked:true;
  const bySource=new Map();
  nwAllItems.forEach((it,i)=>{
    if(womenOnly && !it.women) return;
    if(nwActiveTag && it.tag!==nwActiveTag) return;
    const hay=(it.title+' '+(it.summary||'')).toLowerCase();
    if(terms.length && !terms.every(t=>hay.includes(t))) return;
    (bySource.get(it.source)||bySource.set(it.source,[]).get(it.source)).push({it,i});
  });
  let html='';
  for(const r of nwResults){
    if(!r.ok){ html+=`<div class="nw-feed"><div class="nw-feed-h">${esc(r.name)} <span style="color:#c00;font-weight:400">· ${esc(r.error||'failed')}</span></div></div>`; continue; }
    const rows=bySource.get(r.name)||[]; if(!rows.length) continue;
    let body='';
    for(const {it,i} of rows){
      const d=it.ts?new Date(it.ts).toLocaleDateString('en-GB',{day:'numeric',month:'short'}):'';
      const checked=nwSel.includes(i)?' checked':'';
      body+=`<div class="nw-item" data-i="${i}"><input type="checkbox" data-i="${i}"${checked}/><span class="nw-it-title">${esc(it.title)}</span>${it.link?`<a class="nw-it-link" href="${esc(it.link)}" target="_blank" rel="noopener">source ↗</a>`:''}<span class="nw-it-meta">${esc(r.name)}${it.tag?' · '+esc(it.tag):''}${d?' · '+d:''}</span>${it.summary?`<span class="nw-it-sum">${esc(it.summary)}</span>`:''}</div>`;
    }
    html+=`<div class="nw-feed"><div class="nw-feed-h">${esc(r.name)} <span style="color:#aaa;font-weight:400">· ${rows.length} shown</span></div>${body}</div>`;
  }
  $('nwItems').innerHTML=html||`<p style="color:#999;padding:8px">No stories match this filter.</p>`;
  updateNwSel();
}

$('nwItems').addEventListener('click',e=>{
  if(e.target.closest('a')) return;                       // source link → navigate
  if(e.target.matches('input[type=checkbox]')) return;    // checkbox → change handler
  const row=e.target.closest('.nw-item'); if(!row) return;
  const cb=row.querySelector('input[type=checkbox]'); cb.checked=!cb.checked;
  cb.dispatchEvent(new Event('change',{bubbles:true}));
});
$('nwItems').addEventListener('change',e=>{
  const cb=e.target.closest('input[type=checkbox]'); if(!cb) return;
  const i=parseInt(cb.dataset.i), k=nwSel.indexOf(i);
  if(cb.checked && k<0) nwSel.push(i); else if(!cb.checked && k>=0) nwSel.splice(k,1);
  updateNwSel();
});
function updateNwSel(){
  const n=nwSel.length;
  $('nwSelCount').textContent=n;
  $('nwMode').textContent=n===0?'nothing selected':(n===1?'single rewrite':'roundup of '+n);
  $('nwComposePanel').style.display=nwAllItems.length?'block':'none';
  $('nwGenerate').disabled=n===0;
}

$('nwGenerate').addEventListener('click',generateNews);
$('nwRegen').addEventListener('click',regenerateNews);
$('nwUrlGen').addEventListener('click',generateNewsFromUrl);

// Originality guard: warn if the draft shares any verbatim 6+ word run with a source.
function nwCheckOriginality(text,items){
  if(!items||!items.length){ alert('nwPushAlert','inf','No linked sources to compare against — originality check skipped.'); return; }
  const hits=sourceOverlap(text,items,6);
  if(hits.length){
    const shown=hits.slice(0,3).map(h=>`“${esc(h)}”`).join(', ');
    alert('nwPushAlert','wr',`⚠ Originality check: reuses wording from the source — ${shown}${hits.length>3?` and ${hits.length-3} more`:''}. Edit those phrases or click <strong>Regenerate</strong> before publishing.`);
  } else {
    alert('nwPushAlert','ok','✓ Originality check passed — no verbatim phrasing (6+ words) shared with the source.');
  }
}

let nwLastAngle='';
// Core generation, shared by the RSS-selection flow and the paste-a-URL flow.
async function nwRunGeneration(items, angle){
  nwEditPath=''; nwEditDate=''; nwEditSources=null; $('nwSlug').readOnly=false; $('nwPush').textContent='Push as draft →';
  nwLastItems=items; nwLastAngle=angle||'';
  $('nwOutPanel').style.display='block';
  $('nwBody').value=''; $('nwPreview').innerHTML='<p style="padding:12px;color:#999">Writing…</p>';
  $('nwView').style.display='none'; alert('nwPushAlert','','');
  nwHeroImgs=[]; nwHeroCredit=''; $('nwHeroGrid').innerHTML=''; $('nwHero').value=''; $('nwStockQuery').value=''; $('nwHeroNote').style.display='none';
  const text=await aiStream({
    system:NEWS_SYSTEM,
    messages:[{role:'user',content:buildNewsPrompt(items,angle||'')}],
    max_tokens:1800,
    onText:(t)=>{ $('nwBody').value=t; },
  });
  const {title,body}=splitHeadline(text);
  $('nwTitle').value=title||'Untitled article';
  $('nwSlug').value=slugify(title||'news-article');
  $('nwBody').value=body;
  if(!$('nwTopic').value) $('nwTopic').value=(items[0]&&items[0].tag)||"Women's Sport";
  renderNwPreview();
  await nwEnforceOriginality(items);
  nwAutoHero(items);
}
async function generateNews(){
  if(!nwSel.length) return;
  const items=nwSel.map(i=>nwAllItems[i]).filter(Boolean);
  const btn=$('nwGenerate'), rbtn=$('nwRegen');
  btn.disabled=true; rbtn.disabled=true; btn.textContent='Generating…';
  try{
    alert('nwPushAlert','inf','Fetching source articles for context & the originality check…');
    await nwAttachFullText(items);
    await nwRunGeneration(items, $('nwAngle').value.trim());
  }catch(e){ $('nwPreview').innerHTML=''; alert('nwPushAlert','er','Generation failed: '+esc(e.message)); }
  btn.disabled=nwSel.length===0; rbtn.disabled=false; btn.textContent='✦ Generate draft';
}
async function regenerateNews(){
  const items=nwLastItems||[]; if(!items.length) return;
  const rbtn=$('nwRegen'); rbtn.disabled=true; const orig=rbtn.textContent; rbtn.textContent='Regenerating…';
  try{ await nwRunGeneration(items, nwLastAngle); }
  catch(e){ $('nwPreview').innerHTML=''; alert('nwPushAlert','er','Regeneration failed: '+esc(e.message)); }
  rbtn.disabled=false; rbtn.textContent=orig;
}
// Paste-a-URL flow: read any article and write an original WSS piece from it.
async function generateNewsFromUrl(){
  const url=($('nwUrl').value||'').trim();
  if(!/^https?:\/\//i.test(url)){ alert('nwUrlAlert','er','Paste a full article URL (https://…).'); return; }
  const btn=$('nwUrlGen'); const orig=btn.textContent; btn.disabled=true; btn.textContent='Fetching…';
  alert('nwUrlAlert','inf','Reading the article…');
  try{
    const r=await fetch(apiUrl('/api/article-text'),{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({urls:[url]})});
    const d=await r.json().catch(()=>({}));
    const res=(d.results||[])[0]||{};
    if(!res.ok || !res.text || res.text.length<200){
      alert('nwUrlAlert','er','Couldn’t read enough text from that page ('+esc(res.error||'too little content')+'). Some sites block scraping — try the article’s AMP/print link, or a different source.');
      btn.disabled=false; btn.textContent=orig; return;
    }
    let host=''; try{ host=new URL(url).hostname.replace(/^www\./,''); }catch(_){ }
    const item={ title: res.title || host || 'Article', source: host, link:url, fulltext:res.text, summary:res.text.slice(0,400), tag:'' };
    nwSel=[]; document.querySelectorAll('#nwItems input[type=checkbox]').forEach(c=>c.checked=false); updateNwSel();
    alert('nwUrlAlert','ok','Read “'+esc(item.title)+'” — writing an original WSS story…');
    btn.textContent='Writing…';
    await nwRunGeneration([item], ($('nwUrlAngle').value||'').trim());
    alert('nwUrlAlert','','');
  }catch(e){ alert('nwUrlAlert','er','Failed: '+esc(e.message)); }
  btn.disabled=false; btn.textContent=orig;
}

// Fetch the full text of each source (best-effort) so the model has the real
// article as reference and the originality check compares against it, not the
// short RSS summary. Attaches it.fulltext; silently falls back on failure.
async function nwAttachFullText(items){
  const urls=(items||[]).map(it=>it.link).filter(Boolean);
  if(!urls.length) return;
  try{
    const r=await fetch(apiUrl('/api/article-text'),{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({urls})});
    const d=await r.json().catch(()=>({}));
    const map={}; (d.results||[]).forEach(x=>{ if(x&&x.ok&&x.text) map[x.url]=x.text; });
    items.forEach(it=>{ if(map[it.link]) it.fulltext=map[it.link]; });
  }catch(_){ /* best-effort */ }
}

// Editor pass: re-check the draft against the source full text and, while
// verbatim overlaps remain, ask the model to rewrite the flagged passages.
// Up to 2 rewrites, then report the final status by the buttons.
async function nwEnforceOriginality(items){
  for(let pass=0;;){
    const hits=sourceOverlap($('nwTitle').value+'\n'+$('nwBody').value,items,6);
    if(!hits.length){ alert('nwPushAlert','ok',`✓ Originality check passed${pass?` after ${pass} editor pass${pass>1?'es':''}`:''} — no verbatim phrasing (6+ words) shared with the source.`); return; }
    if(pass>=2){ const shown=hits.slice(0,3).map(h=>`“${esc(h)}”`).join(', '); alert('nwPushAlert','wr',`⚠ ${hits.length} phrase(s) still overlap the source after ${pass} rewrites: ${shown}. Edit those manually or Regenerate.`); return; }
    pass++;
    alert('nwPushAlert','inf',`Editor pass ${pass}: rewriting ${hits.length} flagged passage(s) for originality…`);
    const current=`# ${$('nwTitle').value}\n\n${$('nwBody').value}`;
    const rew=await aiStream({ system:NEWS_SYSTEM, messages:[{role:'user',content:buildRewritePrompt(current,hits)}], max_tokens:1800, onText:(t)=>{ $('nwBody').value=t; } });
    const {title,body}=splitHeadline(rew);
    if(title) $('nwTitle').value=title;
    $('nwBody').value=body; renderNwPreview();
  }
}

function splitHeadline(md){
  const m=(md||'').match(/^\s*#\s+(.+?)\s*$/m);
  if(!m) return { title:'', body:(md||'').trim() };
  return { title:m[1].trim(), body:(md.slice(0,m.index)+md.slice(m.index+m[0].length)).replace(/^\s+/,'').trim() };
}
function deriveExcerpt(body){
  const line=(body||'').split('\n').map(s=>s.trim()).find(s=>s && !/^[#>!|]/.test(s) && !/^[-*]\s/.test(s));
  return (line||'').replace(/\*\*?|`/g,'').replace(/\[([^\]]+)\]\([^)]*\)/g,'$1').slice(0,180);
}
